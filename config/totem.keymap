#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NUM 1
#define SYM 2
#define ADJUST 3

#define QUICK_TAP_MS 175
#define SKHD(key) LC(LA(LS(LG(key))))

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31
#define THUMBS 32 33 34 35 36 37

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_language_toggle {
            timeout-ms = <35>;
            require-prior-idle-ms = <150>;
            key-positions = <34 35>;
            bindings = <&kp LG(SPACE)>;
        };

        combo_left_thumb_quotes {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <32 33 34>;
            bindings = <&kp LS(APOS)>;
        };

        combo_right_thumb_apostrophe {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <35 36 37>;
            bindings = <&kp APOS>;
        };

        combo_left_bracket {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <3 4>;
            layers = <BASE>;
            bindings = <&kp LBKT>;
        };

        combo_left_paren {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <13 14>;
            layers = <BASE>;
            bindings = <&kp LS(N9)>;
        };

        combo_left_brace {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <24 25>;
            layers = <BASE>;
            bindings = <&kp LS(LBKT)>;
        };

        combo_right_bracket {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <5 6>;
            layers = <BASE>;
            bindings = <&kp RBKT>;
        };

        combo_right_paren {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <15 16>;
            layers = <BASE>;
            bindings = <&kp LS(N0)>;
        };

        combo_right_brace {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <26 27>;
            layers = <BASE>;
            bindings = <&kp LS(RBKT)>;
        };

        combo_question {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <27 28>;
            layers = <BASE>;
            bindings = <&kp LS(FSLH)>;
        };

        combo_colon {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <6 7>;
            layers = <BASE>;
            bindings = <&kp LS(SEMI)>;
        };

        combo_semicolon {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <7 8>;
            layers = <BASE>;
            bindings = <&kp SEMI>;
        };

        combo_plus {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <5 15>;
            layers = <BASE>;
            bindings = <&kp LS(EQUAL)>;
        };

        combo_star {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <15 6>;
            layers = <BASE>;
            bindings = <&kp LS(N8)>;
        };

        combo_minus {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <2 3>;
            layers = <BASE>;
            bindings = <&kp MINUS>;
        };

        combo_underscore {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <1 2>;
            layers = <BASE>;
            bindings = <&kp LS(MINUS)>;
        };

        combo_equal {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <4 14>;
            layers = <BASE>;
            bindings = <&kp EQUAL>;
        };

        combo_grave {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <0 1>;
            layers = <BASE>;
            bindings = <&kp GRAVE>;
        };

        combo_apostrophe {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <8 9>;
            layers = <BASE>;
            bindings = <&kp APOS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            label = "BASE";
            bindings = <
                &kp Q          &kp W          &kp E          &kp R          &kp T          &kp Y          &kp U          &kp I          &kp O          &kp P
                &hml LSHFT A   &hml LCTRL S   &hml LALT D    &hml LGUI F    &kp G          &kp H          &hmr RGUI J   &hmr RALT K   &hmr RCTRL L  &hmr RSHFT SEMI
                &kp ESC        &kp Z          &kp X          &kp C          &kp V          &kp B          &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp ENTER
                                                            &kp TAB        &mo NUM        &kp SPACE      &kp BSPC       &mo SYM        &kp ENTER
            >;
        };

        num {
            label = "NUM";
            bindings = <
                &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0
                &kp LSHFT      &kp LCTRL      &kp LALT       &kp LGUI       &kp SKHD(G)    &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &kp CAPS
                &kp ESC        &kp SKHD(Z)    &kp SKHD(X)    &kp SKHD(C)    &kp SKHD(V)    &kp SKHD(B)    &kp HOME       &kp PAGE_DOWN  &kp PAGE_UP    &kp END        &kp PSCRN      &kp ENTER
                                                            &trans         &trans         &trans         &kp COMMA &trans &kp LS(FSLH)
            >;
        };

        sym {
            label = "SYM";
            bindings = <
                &kp LS(N1)     &kp LS(N2)     &kp LS(N3)     &kp LS(N4)     &kp LS(N5)     &kp LS(N6)     &kp LS(N7)     &kp LS(N8)     &kp LS(N9)     &kp LS(N0)
                &kp BSLH       &kp LS(BSLH)   &kp SEMI       &kp LS(SEMI)   &kp APOS &kp MINUS &kp EQUAL &kp LS(LBKT) &kp LS(RBKT) &kp LS(BSLH)
                &kp ESC        &kp LS(APOS) &kp LS(COMMA) &kp LS(DOT) &kp COMMA &kp LS(FSLH) &kp LS(MINUS) &kp LS(EQUAL) &kp LBKT &kp RBKT &kp BSLH &kp ENTER
                                                            &kp FSLH &trans &kp DOT &trans &trans &kp ENTER
            >;
        };

        adjust {
            label = "ADJUST";
            bindings = <
                &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &bt BT_SEL 0   &kp C_BRI_DEC &kp C_BRI_INC &bt BT_SEL 1   &bt BT_SEL 2
                &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &bt BT_SEL 3   &kp C_VOLUME_DOWN &kp C_MUTE &kp C_VOLUME_UP &bt BT_SEL 4
                &kp ESC        &sys_reset     &bt BT_CLR_ALL &bootloader    &kp F11        &kp F12        &bt BT_SEL 5   &kp C_PREV    &kp C_PLAY_PAUSE &kp C_NEXT &bt BT_CLR &kp ENTER
                                                            &trans         &trans         &trans         &trans         &trans         &kp ENTER
            >;
        };

        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <NUM SYM>;
            then-layer = <ADJUST>;
        };
    };
};
