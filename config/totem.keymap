#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define ADJUST 3

#define QUICK_TAP_MS 175

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31
#define THUMBS 32 33 34 35 36 37

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_language_toggle {
            timeout-ms = <35>;
            require-prior-idle-ms = <150>;
            key-positions = <34 35>;
            layers = <BASE>;
            bindings = <&kp GLOBE>;
        };

        combo_grave_ru_io {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <0 1>;
            layers = <BASE>;
            bindings = <&kp GRAVE>;
        };

        combo_left_bracket_ru_ha {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <6 7>;
            layers = <BASE>;
            bindings = <&kp LBKT>;
        };

        combo_right_bracket_ru_hard_sign {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <7 8>;
            layers = <BASE>;
            bindings = <&kp RBKT>;
        };

        combo_left_paren {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <3 4>;
            layers = <BASE>;
            bindings = <&kp LPAR>;
        };

        combo_left_bracket {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <13 14>;
            layers = <BASE>;
            bindings = <&kp LBKT>;
        };

        combo_left_brace {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <23 24>;
            layers = <BASE>;
            bindings = <&kp LBRC>;
        };

        combo_right_paren {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <5 6>;
            layers = <BASE>;
            bindings = <&kp RPAR>;
        };

        combo_right_bracket {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <15 16>;
            layers = <BASE>;
            bindings = <&kp RBKT>;
        };

        combo_right_brace {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <26 27>;
            layers = <BASE>;
            bindings = <&kp RBRC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
           &kp Q       &kp W       &kp E        &kp R        &kp T       &kp Y       &kp U        &kp I        &kp O       &kp P
           &hml LSHFT A &hml LCTRL S &hml LALT D &hml LGUI F  &kp G       &kp H       &hmr RGUI J  &hmr RALT K  &hmr RCTRL L &hmr RSHFT SEMI
&kp ESC    &kp Z       &kp X       &kp C        &kp V        &kp B       &kp N       &kp M        &kp COMMA    &kp DOT     &kp FSLH  &kp APOS
                                   &kp TAB      &mo NAV      &kp SPACE   &kp BSPC    &mo SYM      &kp ENTER
            >;
        };

        nav {
            bindings = <
              &kp N1       &kp N2          &kp N3          &kp N4        &kp N5       &kp N6      &kp N7           &kp N8          &kp N9       &kp N0
              &mt LGUI HOME &mt LALT INS    &mt LSHFT DEL   &mt LCTRL END &kp ENTER    &kp LEFT    &kp DOWN         &kp UP          &kp RIGHT    &trans
&kp PAGE_UP   &kp PAGE_DOWN &trans          &trans          &kp PSCRN     &kp LA(LEFT) &kp LG(LEFT) &kp LG(RIGHT)    &kp LA(RIGHT)   &trans       &kp CAPS  &caps_word
                                             &trans          &trans        &kp DOT      &trans      &mo ADJUST       &trans
            >;
        };

        symbols {
            bindings = <
              &kp AT       &kp LESS_THAN      &kp EQUAL     &kp GREATER_THAN      &kp GRAVE        &kp CARET    &kp DOUBLE_QUOTES  &kp UNDER        &kp APOS          &none
              &mt LGUI BSLH &mt LALT LPAR      &mt LSHFT MINUS &mt LCTRL RPAR      &kp PLUS         &kp PERCENT  &mt RCTRL LBRC      &mt RSHFT SEMI   &mt RALT RBRC     &mt RGUI EXCL
&kp HASH      &kp STAR     &kp COLON          &kp FSLH      &trans               &trans           &trans       &trans              &kp PIPE         &kp TILDE        &kp AMPERSAND     &kp DLLR
                                             &trans         &mo ADJUST           &trans           &kp COMMA    &trans              &kp QMARK
            >;
        };

        adjust {
            bindings = <
               &bootloader &kp F1          &kp F2          &kp F3          &kp F4       &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3       &bt BT_SEL 4
               &kp LGUI    &mt LALT F5     &mt LSHFT F6    &mt LCTRL F7    &kp F8       &out OUT_BLE       &kp C_VOLUME_DOWN  &kp C_MUTE         &kp C_VOLUME_UP    &bt BT_CLR
&trans         &kp F9      &kp F10         &kp F11         &kp F12         &trans       &trans             &out OUT_USB       &kp C_PREV         &kp C_PLAY_PAUSE   &kp C_NEXT         &none
                                             &trans         &trans          &trans       &trans             &trans             &trans
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <NAV SYM>;
            then-layer = <ADJUST>;
        };
    };
};
